# Exness Admin Testing Mode (server-side only)
# When true, only addresses listed in ADMIN_EMAILS may use these credentials.
EXNESS_TEST_MODE=false
EXNESS_TEST_API_KEY=
EXNESS_TEST_PRIVATE_KEY=
EXNESS_TEST_ACCOUNT_ID=
EXNESS_TEST_GATEWAY_URL=

# Required for encrypted per-user Exness credentials in Firestore
EXNESS_CREDENTIALS_ENCRYPTION_KEY=

# Comma-separated Firebase admin email allowlist
ADMIN_EMAILS=

# Dedicated server-side encryption secret for UID-bound cTrader OAuth tokens (generate 32+ random chars)
CTRADER_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Distributed API rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exness orders are sent to the account whose credentials the user connected.
